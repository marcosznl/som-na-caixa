PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Chave da YouTube Data API v3 (console.cloud.google.com), usada pra busca de
# músicas. Sem ela, a busca não funciona (só colar link continua ok).
YOUTUBE_API_KEY=

# Senha pra entrar na sala. Deixe em branco pra não exigir senha (padrão).
# Útil se o app estiver acessível pela internet e você só quiser que suas
# pessoas de confiança entrem.
ROOM_PASSWORD=

# Limite de buscas no YouTube por dia (cada busca custa 100 unidades da cota
# gratuita de 10.000/dia = ~100 buscas/dia no total). Ajuste se quiser.
YOUTUBE_SEARCH_DAILY_LIMIT=80
